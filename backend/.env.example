# Copy this to .env and fill in real values — NEVER commit .env to git

PORT=3001
NODE_ENV=development

# Generate a secure secret:  node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=replace_with_64_byte_random_hex

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SQLite DB path (relative to backend/)
DB_PATH=./data/app.db

# CORS — comma-separated allowed origins
# Development:
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# Production (set this in Render dashboard, not here):
# ALLOWED_ORIGINS=https://fiveminpush.com,https://www.fiveminpush.com
